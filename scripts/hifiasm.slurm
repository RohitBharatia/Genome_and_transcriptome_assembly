#!/usr/bin/env bash
#SBATCH --job-name="hifiasm"
#SBATCH --output=/data/users/rbharatia/Genome_transcriptome_assembly/results/assembly/hifiasm_results/hifiasm_%j.out
#SBATCH --error=/data/users/rbharatia/Genome_transcriptome_assembly/logs/assembly/hifiasm/hifiasm_%j.err
#SBATCH --time=1-00:00:00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=16
#SBATCH --partition=pibu_el8
#SBATCH --mail-user=rohit.bharatia@students.unibe.ch
#SBATCH --mail-type=END,FAIL

#SETTING DIRECTORIES
CONTAINER="/containers/apptainer/hifiasm_0.25.0.sif"
INPUT_DIR="/data/users/rbharatia/Genome_transcriptome_assembly/data/Anz-0"
OUTPUT_DIR="/data/users/rbharatia/Genome_transcriptome_assembly/results/assembly/hifiasm_results"
# Remember to change the input directory to the output directory of flye assembly because we need to use 
# the .gfa file generated by flye assembly to convert it into fasta format and then use that fasta file as input for hifiasm assembly.

#converting the fastq.gz file to fasta format using awk command. 
#awk '/^S/{print ">"$2;print $3}' $Input_dir/*.fastq.gz > $Input_dir/anz_0.fa

#gunzip -c ${Input_dir}/*.fastq.gz > ${Input_dir}/anz_0_unzipped.fa

# Then try hifiasm on the cleaned file

# Run hifiasm assembly (PacBio HiFi reads)
apptainer exec --bind /data "${CONTAINER}" hifiasm \
    -o "${OUTPUT_DIR}/ANZ_0" \
    -t "${SLURM_CPUS_PER_TASK}" \
    "${INPUT_DIR}"/*.fastq.gz

echo "Task complete!"
